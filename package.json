{
  "name": "kaffeeroesterei",
  "version": "0.1.0",
  "private": true,
  "description": "Browser idle game, theme 1: coffee roastery",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:browser": "playwright test",
    "sim": "node tools/simulate.mjs",
    "build": "node tools/build.mjs",
    "check:size": "node tools/check-size.mjs",
    "check": "npm test && npm run sim && npm run build && npm run check:size && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
